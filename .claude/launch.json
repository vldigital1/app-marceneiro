{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-completo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/servidor-local.mjs"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    },
    {
      "name": "site-estatico",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "out"
      ],
      "port": 4173
    },
    {
      "name": "teste-loja",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VERCEL=1",
        "NEXT_PUBLIC_LOJA=1",
        "SENHAS=TESTE-LOJA-1",
        "SEGREDO=segredo-de-teste-local-com-mais-de-24-chars",
        "next",
        "start",
        "-p",
        "4177"
      ],
      "port": 4177
    }
  ]
}