# Bloqueia acesso direto a arquivos internos (_config.php, _lib.php, _dados/)
Options -Indexes
<FilesMatch "^_">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)_ - [F,L]
</IfModule>
